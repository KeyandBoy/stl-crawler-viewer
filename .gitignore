# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local STL model files (use Vercel Blob in production)
/public/stl-models/

# local site cookies / sensitive config
/data/

# browser agent dependencies and local runtime output
/browser-agent/node_modules/
/browser-agent/.playwright/
/dev-server.log
/test-results.log
/test-log-v2.txt
